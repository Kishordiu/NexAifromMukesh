# API server configuration. Copy this file to .env locally; never commit the populated file.
PORT=3001
NODE_ENV=development
# Generate a private random value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-here
# Comma-separated email allowlist for clinician roles. Only add verified accounts.
CLINICIAN_EMAILS=
# Optional API key for server-side triage. Leave as the placeholder until configured.
DEEPSEEK_API_KEY=your-key-here
